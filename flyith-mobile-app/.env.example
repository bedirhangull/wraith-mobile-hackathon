# Copy this file to .env and fill in real values. .env is git-ignored.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_SERPAPI_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web OAuth client ID from Google Cloud Console — required for Google Sign-In.
# Also add it to Supabase Dashboard > Authentication > Providers > Google > Authorized Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID from Google Cloud Console (CLIENT_ID in GoogleService-Info.plist).
# Required on iOS so RNGoogleSignin can resolve the client without looking for a Firebase plist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# RevenueCat iOS public SDK key (appl_...). Optional until purchases are wired.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Set to "true" to bypass RevenueCat and use a device-local mock subscription (dev/demo only).
EXPO_PUBLIC_MOCK_PREMIUM=
