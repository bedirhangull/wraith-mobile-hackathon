# Copy this file to .env and fill in real values. .env is git-ignored.
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_SERPAPI_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Web OAuth client ID from Google Cloud Console — required for Google Sign-In.
# Also add it to Supabase Dashboard > Authentication > Providers > Google > Authorized Client IDs.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
